# 各設定の取り得る値を型の形式で示す
# uint: 0以上の整数
# int: 整数
# boolean: TRUE | FALSE
# null: 空欄
# =の先は初期値または推奨値

# 基本の設定
# 利用規約の同意 boolean
EULA=TRUE 
# どんなサーバーか string
TYPE=NEOFORGE 
# packwizでのMOD管理
PACKWIZ_URL=
# バージョン管理
VERSION=
TZ=Asia/Tokyo

# ゲーム設定
DIFFICULTY=NORMAL
PVP=TRUE

# 接続設定
# IPアドレス IPアドレス=null
SERVER_IP='' 
# リッスンするポート uint=25565
SERVER_PORT=25565 
# MOJANG認証の必須化 boolean=TRUE
ONLINE_MODE=TRUE 
# VPNやプロキシをブロックするか boolean
PRIVENT_PROXY_CONNECTION=TRUE 
# 通信圧縮のしきい値 uint=256
NETWORK_COMPRESSTION_THRESHOLD=256 
# パケット送信料制限 uint
RATE_LIMIT=0 
# サーバー一覧に状態を表示する boolean=TRUE
ENABLE_STATUS=TRUE 
# 外部ツール向けクエリ boolean=FALSE
ENABLE_QUERY=FALSE 
# 外部ツール向けクエリ用のポート uint
# QUERY_PORT= 
# 外部ツールからサーバーコンソールのコマンドを実行する仕組みのrconを使うかどうか boolean=false
ENABLE_RCON=FALSE 
# rconのポート
# RCON_PORT=  
# rconのパスワード
# RCON_PASSWORD= 

# ホワイトリスト
# ホワイトリストの有効化 boolean
ENABLE_WHITELIST=FALSE
# ホワイトリストの強制 boolean
ENFORCE_WHITELIST=FALSE
# 環境変数の内容に同期
EXISTINT_WHITELIST_FILE=
WHITELIST=

# OP権限
# 環境変数の内容に同期
EXISTING_OPS_FILE=
# OP権限レベル
OP_PERMISSION_LEVEL=
# OP権限リスト
OPS=


# 負荷に関わる設定

# メモリの上限 int + 単位
MEMORY=4G
# サーバーの最大人数 uint
MAX_PLAYERS=10
# クライアントが見れるチャンク距離 uint
VIEW_DISTANCE=8
# サーバーが処理するチャンク距離 uint
SIMULATION_DISTANCE=6
# 動物をスポーンさせるか boolean
SPAWN_ANIMALS=TRUE
# 動物をスポーンさせるか boolean
SPAWN_MONSTERS=TRUE
# 村人をスポーンさせるか boolean
SPQWN_NPCS=TRUE
# 1tick処理の許容時間 uint
MAX_TICK_TIME=60000
